                  "id": "planet-order",
                  "prompt": "Put the planets in order from the Sun",
                  "hints": ["Start from Mercury", "There are 8 planets"],
                  "choices": [
                    "Mercury, Venus, Earth, Mars, Jupiter, Saturn, Uranus, Neptune",
                    "Earth, Venus, Mercury, Mars, Jupiter, Saturn, Uranus, Neptune",
                    "Mercury, Venus, Mars, Earth, Jupiter, Saturn, Uranus, Neptune"
                  ],
                  "answer": "Mercury, Venus, Earth, Mars, Jupiter, Saturn, Uranus, Neptune",
                  "explanation": "The planets are ordered by average distance from the Sun.",
                  "narrative": "You are a spaceship pilot charting a route through the Solar System."
                },
                {
                  "id": "gas-giants",
                  "prompt": "Identify the gas giants",
                  "hints": ["Think large outer planets"],
                  "choices": ["Jupiter and Saturn", "Earth and Mars", "Mercury and Venus"],
                  "answer": "Jupiter and Saturn",
                  "explanation": "Jupiter and Saturn are gas giants; Uranus and Neptune are ice giants.",
                  "narrative": "You detect massive storms on giant worlds in the outer region."
                }
              ]
