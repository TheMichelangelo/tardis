              "topic": "Math",
              "formats": [
                "quiz",
                "story",
                "flashcards"
              ],
              "exercises": [
                {
                  "id": "pizza-diagram",
                  "label": "Study pizza fraction diagram and mark equal parts",
                  "type": "diagram"
                },
                {
                  "id": "equivalent-fractions-table",
                  "label": "Fill equivalent fractions table",
                  "type": "table",
                  "columns": [
                    "Fraction",
                    "Equivalent 1",
                    "Equivalent 2"
                  ],
                  "rows": [
                    "1/2",
                    "1/3",
                    "3/4"
                  ],
                  "dataToFill": [
                    "2/4",
                    "3/6",
                    "2/6",
                    "3/9",
                    "6/8",
                    "9/12"
                  ]
                },
                {
                  "id": "fractions-reading",
                  "label": "Read text and note key ideas",
                  "type": "text",
                  "text": "Fractions represent parts of a whole. Equivalent fractions have different numerators and denominators but equal value.",
                  "questions": [
                    "What is an equivalent fraction for 1/2?",
                    "Why can two fractions look different but be equal?"
                  ]
                },
                {
                  "id": "fraction-song-video",
                  "label": "Watch introduction video",
                  "type": "video",
                  "youtubeUrl": "https://www.youtube.com/watch?v=VAgt2vo9HdE&list=PLJ9FKnrqZM71kB2c1gheBXiKyS9n3c4kg"
                },
                {
                  "id": "fraction-quiz-cards",
                  "label": "Interactive fraction flashcards",
                  "type": "interactive_quiz",
                  "questions": [
                    {
                      "id": "q1",
                      "question": "Which is equivalent to 1/2?",
                      "answerTypes": {
                        "singleChoice": [
                          "2/4",
                          "3/5",
                          "5/8"
                        ],
                        "trueFalse": "True",
                        "shortText": "2/4"
                      }
                    },
                    {
                      "id": "q2",
                      "question": "What is 1/2 of 10?",
                      "answerTypes": {
                        "singleChoice": [
                          "3",
                          "5",
                          "7"
                        ],
                        "trueFalse": "True",
                        "shortText": "5"
                      }
                    }
                  ]
                }
              ]
            },
            {
