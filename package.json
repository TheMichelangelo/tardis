{
  "name": "stem-lesson-builder",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "sync-materials": "node scripts/sync-materials.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "web": "npm run sync-materials && expo start --web",
    "export:web": "npm run sync-materials && expo export -p web --output-dir dist --clear",
    "predeploy": "npm run export:web && node scripts/prepare-gh-pages.mjs && touch dist/.nojekyll",
    "deploy": "gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "bcryptjs": "^3.0.3",
    "expo": "^55.0.5",
    "expo-file-system": "~18.0.12",
    "expo-print": "~14.0.3",
    "expo-sharing": "~13.0.1",
    "expo-sqlite": "~16.0.8",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~18.3.12",
    "gh-pages": "^6.3.0",
    "typescript": "^5.7.3"
  }
}
